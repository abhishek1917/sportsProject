DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production (Render / Railway / any host): set DEBUG to false and list
# the live hostname plus your domain later, e.g.
# DJANGO_ALLOWED_HOSTS=stadium-booking.onrender.com,www.yourdomain.com
# PUBLIC_BASE_URL=https://www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com
# DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME
# DATABASE_SSL=true

# MSG91 SMS (leave blank in development — confirmations are logged instead)
MSG91_AUTHKEY=
MSG91_SENDER=STADIUM

# Optional shared secret for the voice-agent API (X-Internal-Key header)
INTERNAL_API_KEY=

# Book on call — Twilio rings the logged-in user's phone, Gemini talks and books
# On Render this can be left blank; the platform URL is used until you set a domain.
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_FROM_NUMBER=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VOICE_APP_ID=1323148
EXOTEL_OUTBOUND_ENABLED=true
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=unknown
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DEEPGRAM_API_KEY=
CSRF_TRUSTED_ORIGINS=
